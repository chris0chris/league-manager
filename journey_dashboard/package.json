{
  "name": "journey_dashboard",
  "version": "5.15.10",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "dependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axios": "1.21.1",
    "i18next": "27.1.3",
    "i18next-browser-languagedetector": "8.3.0",
    "i18next-resources-to-backend": "1.2.4",
    "react": "19.3.1",
    "react-bootstrap": "2.10.10",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.2",
    "react-router-dom": "7.18.5",
    "react-select": "5.10.2",
    "uuid": "14.0.3",
    "web-vitals": "6.2.3"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "watch": "vite build --watch",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "eslint": "eslint ./src",
    "eslint:junit": "eslint ./src --format junit -o /tmp/eslint/js-lint-results-journey_dashboard.xml",
    "eslint:json": "eslint ./src --format json -o js-lint-results-journey_dashboard.json",
    "dev": "vite build",
    "i18n:types": "i18next-resources-for-ts toc -i ./src/i18n/locales/de -o ./src/i18n/types.d.ts",
    "prebuild": "npm run i18n:types"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-transform-private-property-in-object": "8.0.5",
    "@emnapi/core": "^1.11.1",
    "@emnapi/runtime": "^1.11.1",
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/react-router-dom": "5.3.3",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/ui": "5.1.0",
    "esbuild": "^0.28.1",
    "eslint": "10.15.0",
    "eslint-formatter-junit": "9.0.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "i18next-resources-for-ts": "2.1.2",
    "jsdom": "31.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
